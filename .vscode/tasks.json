{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn javafx:run@debug",
            "type": "shell",
            "command": "mvn javafx:run@debug",
            "options": {
                "cwd": "${workspaceFolder}/openautomaker"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "\\[INFO\\] --- javafx",
                    "endsPattern": "Listening for transport dt_socket at address: 8001"
                }
            }
        }
    ]
}
